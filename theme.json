		"custom": {
			"spacing": {
				"xsmall": "max(1rem, 4vw)",
				"small": "max(1.25rem, 5vw)",
				"medium": "clamp(2rem, 8vw, calc(4 * var(--wp--style--block-gap)))",
				"large": "clamp(4rem, 10vw, 8rem)",
				"outer": "var(--wp--custom--spacing--small, 1.25rem)"
			},
			"typography": {
				"font-size": {
					"huge": "clamp(2.25rem, 4vw, 2.75rem)",
					"gigantic": "clamp(2.75rem, 6vw, 3.25rem)",
					"colossal": "clamp(3.25rem, 8vw, 6.25rem)"
				},
				"line-height": {
					"tiny": 1.15,
					"small": 1.2,
					"medium": 1.4,
					"normal": 1.6
				}
			}
		},
		"spacing": {
			"units": [
				"%",
				"px",
				"em",
				"rem",
				"vh",
				"vw"
			]
		},
		"typography": {
			"dropCap": false,
			"fontFamilies": [
				{
					"fontFamily": "-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Oxygen-Sans,Ubuntu,Cantarell,\"Helvetica Neue\",sans-serif",
					"name": "System Font",
					"slug": "system-font"
				},
				{
					"fontFamily": "'Space Grotesk', system-ui, sans-serif",
					"name": "Space Grotesk",
					"slug": "space-grotesk"
				},
				{
					"fontFamily": "'IBM Plex Sans', system-ui, sans-serif",
					"name": "IBM Plex Sans",
					"slug": "ibm-plex-sans"
				},
				{
					"fontFamily": "'IBM Plex Mono', ui-monospace, monospace",
					"name": "IBM Plex Mono",
					"slug": "ibm-plex-mono"
				}
			],
			"fontSizes": [
				{
					"size": "1rem",
					"slug": "small"
				},
				{
					"size": "1.125rem",
					"slug": "medium"
				},
				{
					"size": "1.75rem",
					"slug": "large"
				},
				{
					"size": "clamp(1.75rem, 3vw, 2.25rem)",
					"slug": "x-large"
				}
			]
		},
		"layout": {
			"contentSize": "650px",
			"wideSize": "1000px"
		}
	},
	"styles": {
		"blocks": {
			"core/button": {
				"border": {
					"radius": "0"
				},
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--background)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)"
				}
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--space-grotesk)",
					"fontWeight": "500",
					"lineHeight": "var(--wp--custom--typography--line-height--tiny)",
					"fontSize": "var(--wp--custom--typography--font-size--gigantic)"
				}
			},
			"core/post-comments": {
				"spacing": {
					"padding": {
						"top": "var(--wp--custom--spacing--small)"
					}
				}
			},
			"core/pullquote": {
				"border": {
					"width": "1px 0"
				}
			},
			"core/query-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--space-grotesk)",
					"fontWeight": "500",
					"lineHeight": "var(--wp--custom--typography--line-height--small)",
					"fontSize": "var(--wp--custom--typography--font-size--gigantic)"
				}
			},
			"core/quote": {
				"border": {
					"width": "1px"
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--space-grotesk)",
					"lineHeight": "var(--wp--custom--typography--line-height--normal)",
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontStyle": "normal",
					"fontWeight": "500"
				}
			}
		},
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--foreground)"
		},
		"elements": {
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--space-grotesk)",
					"fontWeight": "500",
					"lineHeight": "var(--wp--custom--typography--line-height--tiny)",
					"fontSize": "var(--wp--custom--typography--font-size--colossal)"
				},
				"color": {
					"text": "var(--wp--preset--color--offwhite)"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--space-grotesk)",
					"fontWeight": "500",
					"lineHeight": "var(--wp--custom--typography--line-height--small)",
					"fontSize": "var(--wp--custom--typography--font-size--gigantic)"
				},
				"color": {
					"text": "var(--wp--preset--color--offwhite)"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--space-grotesk)",
					"fontWeight": "500",
					"lineHeight": "var(--wp--custom--typography--line-height--tiny)",
					"fontSize": "var(--wp--custom--typography--font-size--huge)"
				},
				"color": {
					"text": "var(--wp--preset--color--offwhite)"
				}
			},
			"h4": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--space-grotesk)",
					"fontWeight": "500",
					"lineHeight": "var(--wp--custom--typography--line-height--tiny)",
					"fontSize": "var(--wp--preset--font-size--x-large)"
				},
				"color": {
					"text": "var(--wp--preset--color--offwhite)"
				}
			},
			"h5": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--ibm-plex-sans)",
					"fontWeight": "600",
					"textTransform": "none",
					"lineHeight": "var(--wp--custom--typography--line-height--normal)",
					"fontSize": "var(--wp--preset--font-size--medium)"
				},
				"color": {
					"text": "var(--wp--preset--color--offwhite)"
				}
			},
			"h6": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--ibm-plex-sans)",
					"fontWeight": "500",
					"textTransform": "none",
					"lineHeight": "var(--wp--custom--typography--line-height--normal)",
					"fontSize": "var(--wp--preset--font-size--medium)"
				},
				"color": {
					"text": "var(--wp--preset--color--offwhite)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				}
			}
		},
		"spacing": {
			"blockGap": "1.5rem"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--ibm-plex-sans)",
			"lineHeight": "var(--wp--custom--typography--line-height--normal)",
			"fontSize": "var(--wp--preset--font-size--medium)"
		},
		"css": ".ds-panel{background:var(--wp--preset--color--secondary);border:1px solid var(--wp--preset--color--tertiary);clip-path:polygon(0 0,calc(100% - 20px) 0,100% 20px,100% 100%,0 100%);padding:var(--wp--custom--spacing--small,1.25rem)}\n.ds-status{display:inline-flex;align-items:center;gap:.5em;font-family:var(--wp--preset--font-family--ibm-plex-sans);font-size:.95rem;color:var(--wp--preset--color--foreground)}\n.ds-status::before{content:\"\";width:.6em;height:.6em;border-radius:50%;background:currentColor}\n.ds-status.is-finished{color:var(--wp--preset--color--primary)}\n.ds-status.is-in-development{color:var(--wp--preset--color--orange)}\n.ds-stack{font-family:var(--wp--preset--font-family--ibm-plex-mono);font-size:.85rem;color:var(--wp--preset--color--foreground);opacity:.85}\n/* Temporary contrast safety net: text set with old light-theme palette slugs stays readable on the dark background. */\n.has-dark-color,.has-secondary-color,.has-tertiary-color,.has-navy-color,.has-blue-color,.has-aqua-color,.has-yellow-color,.has-purple-color,.has-mauve-color,.has-magenta-color,.has-green-color,.has-forest-color,.has-beige-color{color:var(--wp--preset--color--offwhite)!important}"
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "header-large-dark",
			"title": "Header (Dark, large)",
			"area": "header"
		},
		{
			"name": "header-small-dark",
			"title": "Header (Dark, small)",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}
